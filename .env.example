# Server-only. Never use a VITE_ prefix for API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Hosted Agents API. The key needs api.agents.read, api.agents.write,
# and api.responses.write in the OpenAI project.
OPENAI_AGENT_MODEL=gpt-6-astra
# Saved OpenAI agent; when set, new sessions inherit its portal configuration.
OPENAI_AGENT_ID=
CHAT_BACKEND=agents
# Optional public booking page. Never put a calendar token here.
BOOKING_URL=
# Owner-approved meeting length, time zone, hours, and confirmation rules.
MEETING_DETAILS=
# Google Calendar: owner-only OAuth credentials; never prefix these with VITE_.
# Register a Web application OAuth client with this redirect URI:
# http://127.0.0.1:53682/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OWNER_EMAIL=
# Populated by npm run calendar:connect after the owner authorizes Google.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Leave blank until the owner approves the rules. Example:
# {"timeZone":"America/Los_Angeles","durationMinutes":30,"weekdays":[1,2,3,4,5],"startTime":"09:00","endTime":"17:00","noticeHours":24,"bufferMinutes":15,"horizonDays":21}
GOOGLE_CALENDAR_RULES=
# Local development uses /api/chat automatically. Production uses the AWS URL.
# VITE_CHAT_API_URL=
